{
  "name": "bibliotter",
  "productName": "Bibliotter",
  "version": "0.1.0",
  "author": "kamilbakierzynski",
  "private": true,
  "description": "Lokalna biblioteka i viewer dokumentów HTML i Markdown generowanych przez agentów",
  "main": "out/main/index.js",
  "bin": {
    "bibliotter": "out/main/cli.js",
    "htmldocs": "out/main/cli.js"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "build:plugin": "rolldown src/main/mcp.ts --platform node --format cjs --file plugin/bibliotter/server/mcp.cjs",
    "start": "electron-vite preview",
    "dist:win": "npm run build:plugin && electron-vite build && electron-builder --win",
    "dist:mac": "npm run build:plugin && electron-vite build && electron-builder --mac",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test-electron-node.mjs",
    "test:e2e": "electron-vite build && powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/hidden-desktop.ps1 node tests/e2e/run.mjs",
    "test:e2e:visible": "electron-vite build && node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "codemirror": "^6.0.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
