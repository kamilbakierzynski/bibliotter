{
  "name": "html-docs-app",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalna biblioteka i viewer dokumentów HTML generowanych przez agentów",
  "main": "out/main/index.js",
  "bin": {
    "htmldocs": "out/main/cli.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test-electron-node.mjs",
    "test:e2e": "electron-vite build && node tests/e2e/run.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
